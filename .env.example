# Шаблон окружения для запуска НА ХОСТЕ.
# При запуске через docker compose эти переменные подставляет сам compose — .env ему не нужен.
# Скопировать в .env (он в .gitignore) и при необходимости поправить адрес базы.

# База из compose: порт 55432 на хосте, потому что 5432 уже занят локальным PostgreSQL 18.
WALLETS_DATABASE_URL=postgresql+asyncpg://wallets:wallets@127.0.0.1:55432/wallets

# Альтернатива — своя локальная база вместо контейнера (тогда Docker нужен только для финальной
# проверки «одной командой»). Подставить своих пользователя/пароль и создать базы wallets и
# wallets_test:
# WALLETS_DATABASE_URL=postgresql+asyncpg://postgres:<пароль>@127.0.0.1:5432/wallets

# Тестовая база. По умолчанию выводится из WALLETS_DATABASE_URL заменой имени базы на wallets_test,
# отдельная переменная нужна только при нетиповой раскладке.
# WALLETS_TEST_DATABASE_URL=postgresql+asyncpg://wallets:wallets@127.0.0.1:55432/wallets_test

WALLETS_LOG_LEVEL=INFO
WALLETS_SQL_ECHO=false
